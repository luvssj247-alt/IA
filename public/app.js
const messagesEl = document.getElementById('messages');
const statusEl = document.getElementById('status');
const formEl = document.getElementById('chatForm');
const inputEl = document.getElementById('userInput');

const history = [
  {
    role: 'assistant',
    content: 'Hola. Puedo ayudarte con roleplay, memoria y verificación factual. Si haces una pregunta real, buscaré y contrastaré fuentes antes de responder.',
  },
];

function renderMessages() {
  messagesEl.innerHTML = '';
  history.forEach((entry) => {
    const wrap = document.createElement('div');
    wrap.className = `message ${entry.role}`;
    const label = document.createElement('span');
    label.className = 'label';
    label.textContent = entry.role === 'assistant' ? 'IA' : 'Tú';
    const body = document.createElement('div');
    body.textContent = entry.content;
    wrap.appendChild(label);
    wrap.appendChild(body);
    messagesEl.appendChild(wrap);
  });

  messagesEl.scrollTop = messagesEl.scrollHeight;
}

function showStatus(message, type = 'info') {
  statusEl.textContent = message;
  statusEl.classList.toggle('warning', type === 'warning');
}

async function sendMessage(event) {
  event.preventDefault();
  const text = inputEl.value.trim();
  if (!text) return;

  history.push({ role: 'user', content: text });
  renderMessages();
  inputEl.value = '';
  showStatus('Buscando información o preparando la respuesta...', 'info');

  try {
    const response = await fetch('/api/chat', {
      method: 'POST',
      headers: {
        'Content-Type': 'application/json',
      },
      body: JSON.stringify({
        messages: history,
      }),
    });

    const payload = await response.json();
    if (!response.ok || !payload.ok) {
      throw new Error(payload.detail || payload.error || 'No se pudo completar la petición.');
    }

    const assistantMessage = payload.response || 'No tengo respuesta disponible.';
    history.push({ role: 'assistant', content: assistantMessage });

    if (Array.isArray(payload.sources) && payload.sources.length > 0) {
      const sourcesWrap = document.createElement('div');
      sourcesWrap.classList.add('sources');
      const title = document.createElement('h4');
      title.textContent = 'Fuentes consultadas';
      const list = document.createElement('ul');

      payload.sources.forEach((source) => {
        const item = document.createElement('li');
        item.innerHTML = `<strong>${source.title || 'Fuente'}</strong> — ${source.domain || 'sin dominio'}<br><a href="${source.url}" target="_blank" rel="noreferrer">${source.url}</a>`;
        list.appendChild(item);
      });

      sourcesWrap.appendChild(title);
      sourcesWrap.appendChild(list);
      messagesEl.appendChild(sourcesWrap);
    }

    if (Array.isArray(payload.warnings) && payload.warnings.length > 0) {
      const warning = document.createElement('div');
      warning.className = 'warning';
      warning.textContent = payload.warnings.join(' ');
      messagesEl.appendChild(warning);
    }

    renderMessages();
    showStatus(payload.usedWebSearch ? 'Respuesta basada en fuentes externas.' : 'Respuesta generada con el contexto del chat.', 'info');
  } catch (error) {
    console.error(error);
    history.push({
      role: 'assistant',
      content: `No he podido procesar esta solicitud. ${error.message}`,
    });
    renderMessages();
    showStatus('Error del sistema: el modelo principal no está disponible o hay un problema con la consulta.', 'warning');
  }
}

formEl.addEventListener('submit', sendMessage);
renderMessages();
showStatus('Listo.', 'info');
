* {
  box-sizing: border-box;
}

:root {
  --bg: #0b1020;
  --panel: #141d2f;
  --panel-alt: #1e2a42;
  --text: #e7ecff;
  --muted: #b4bfd7;
  --accent: #7dc5ff;
  --success: #7be0a3;
  --warning: #ffce73;
  --danger: #ff7a7a;
  --border: rgba(255,255,255,0.08);
}

body {
  margin: 0;
  background: radial-gradient(circle at top, #101941, var(--bg));
  color: var(--text);
  font-family: Arial, sans-serif;
}

.app-shell {
  max-width: 1100px;
  margin: 0 auto;
  min-height: 100vh;
  padding: 24px;
}

.topbar {
  border-bottom: 1px solid var(--border);
  margin-bottom: 20px;
}

.topbar h1 {
  margin-bottom: 4px;
}

.topbar p {
  color: var(--muted);
  margin-top: 0;
}

.chat-panel {
  background: rgba(20, 29, 47, 0.96);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 18px;
  box-shadow: 0 18px 40px rgba(0,0,0,0.2);
}

.messages {
  min-height: 420px;
  max-height: 65vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-right: 8px;
}

.message {
  padding: 14px 16px;
  border-radius: 12px;
  line-height: 1.5;
  max-width: 95%;
}

.message.user {
  margin-left: auto;
  background: #1d3557;
  border: 1px solid rgba(125,197,255,0.3);
}

.message.assistant {
  background: #19283d;
  border: 1px solid rgba(255,255,255,0.05);
}

.message .label {
  display: block;
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.status {
  margin-top: 8px;
  min-height: 22px;
  color: var(--warning);
  font-size: 14px;
}

.composer {
  margin-top: 18px;
}

textarea {
  width: 100%;
  resize: vertical;
  min-height: 82px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: rgba(9,15,24,0.7);
  color: var(--text);
  padding: 14px 16px;
  font: inherit;
}

.composer-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10px;
}

button {
  border: none;
  border-radius: 10px;
  background: var(--accent);
  color: #07111d;
  font-weight: 700;
  padding: 10px 18px;
  cursor: pointer;
}

.sources {
  margin-top: 12px;
  padding: 12px;
  border-radius: 10px;
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--border);
}

.sources h4 {
  margin: 0 0 10px;
  color: var(--success);
}

.sources ul {
  padding-left: 18px;
  margin: 0;
}

.sources li {
  margin-bottom: 8px;
  color: var(--muted);
}

.warning {
  color: var(--danger);
}
